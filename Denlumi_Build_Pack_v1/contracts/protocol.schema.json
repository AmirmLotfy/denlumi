{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:denlumi:protocol:v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "pairing": {
      "type": "string",
      "enum": [
        "cat_cat",
        "dog_dog",
        "cat_dog",
        "single_cat",
        "single_dog",
        "coordination"
      ]
    },
    "newcomer_species": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "cat",
        "dog",
        null
      ]
    },
    "locale": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "demo_only",
        "revoked",
        "expired"
      ]
    },
    "approved_for_live_use": {
      "type": "boolean"
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "review_due_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_session_duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "demo_notice": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "demonstration",
              "preparation",
              "record",
              "review"
            ]
          }
        },
        "required": [
          "key",
          "instruction",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "object",
      "properties": {
        "no_auto_advance": {
          "const": true
        },
        "no_physical_actuation": {
          "const": true
        },
        "unknown_is_not_safe": {
          "const": true
        },
        "human_review_for_progression": {
          "const": true
        }
      },
      "required": [
        "no_auto_advance",
        "no_physical_actuation",
        "unknown_is_not_safe",
        "human_review_for_progression"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "pairing",
    "newcomer_species",
    "locale",
    "status",
    "approved_for_live_use",
    "reviewer_id",
    "reviewed_digest",
    "source_ids",
    "review_due_at",
    "default_session_duration_seconds",
    "demo_notice",
    "steps",
    "invariants"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "approved_for_live_use": {
            "const": true
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_digest": {
            "type": "string",
            "minLength": 32
          },
          "review_due_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "approved_for_live_use": {
            "const": false
          }
        }
      }
    }
  ]
}
